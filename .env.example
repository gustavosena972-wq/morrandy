# Supabase — NÃO usar (limite free / banco compartilhado)
# Banco da Morrandy fica no Neon (app separado).

# Neon Console → projeto morrandy → Connection string
# Use a connection string "pooled" no DATABASE_URL
DATABASE_URL="postgresql://neondb_owner:[SENHA]@[HOST]-pooler.[REGIAO].aws.neon.tech/neondb?sslmode=require"

# Use a connection string "direct" no DIRECT_URL (sem -pooler)
DIRECT_URL="postgresql://neondb_owner:[SENHA]@[HOST].[REGIAO].aws.neon.tech/neondb?sslmode=require"

# Opcional (só se usar Storage depois — não é obrigatório)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

SESSION_SECRET="troque-por-uma-chave-longa-e-aleatoria-minimo-32-caracteres"
